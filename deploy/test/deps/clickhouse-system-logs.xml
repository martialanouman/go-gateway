<!-- step-287b : ClickHouse se journalisait en Trace (défaut de l'image) et gardait ses tables système sans
     limite : 33 Go et des cœurs entiers sur le VPS de test, sans aucun trafic. Monté sur le VPS
     (ConfigMap générée par deploy/test/kustomization.yaml) et par docker-compose.yml. -->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>
    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </text_log>
    <processors_profile_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </part_log>
    <trace_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </trace_log>
    <metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_metric_log>
</clickhouse>
