# Release artifacts (GoReleaser output).
/dist/

# Compiled service binaries built ad-hoc at the repo root (`go build ./cmd/<svc>`). The tracked
# build path is GoReleaser's /dist; these root binaries are never checked in.
/rest-api-svc
/router-svc
/connector-pool-svc
/admin-api-svc
/migrate
/fake-smsc

# Contracts package: the .d.ts are generated at publish time from the YAML, never checked in —
# a committed copy would be one more thing that can drift from its source.
/api/dist/
/api/node_modules/

# Go build & test artifacts.
*.test
*.out
coverage.*

# Local environment overrides.
.env
.env.*

# OS / editor cruft.
.DS_Store
*.swp
.idea/
